<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Banog</RootNamespace>
    <AssemblyName>Banog</AssemblyName>
    <Version>0.1.1</Version>
    <ApplicationManifest>App.Host\app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Le projet unique contient le moteur, l'interface, la surveillance et l'hôte. -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- XAML compilé et sérialisation source-generated : aucune réflexion dynamique. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
    <TrimMode>full</TrimMode>
    <OptimizationPreference>Speed</OptimizationPreference>

    <!-- Avalonia s'appuie sur COM pour le presse-papiers et le glisser-déposer Win32. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Métadonnées d'exécution inutiles pour cet utilitaire desktop. -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>IL2026;IL2046;IL2072;IL2075;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Les anciens dossiers obj/bin des projets fusionnés ne doivent jamais devenir des
         sources quand le projet unique parcourt tout le dossier src. -->
    <Compile Remove="**\bin\**;**\obj\**" />
    <EmbeddedResource Remove="**\bin\**;**\obj\**" />
    <None Remove="**\bin\**;**\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" />
  </ItemGroup>

</Project>
